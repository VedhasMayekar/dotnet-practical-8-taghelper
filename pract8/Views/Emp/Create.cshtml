@model pract8.Models.EmployeeModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewBag.Title = "Form To Create a User";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 760px; margin: 30px auto; padding: 0 18px; }
        .form-group { margin-bottom: 14px; }
        label { display: block; margin-bottom: 5px; }
        input:not([type=checkbox]):not([type=radio]), textarea, select { width: 100%; max-width: 600px; padding: 8px; box-sizing: border-box; }
        button { padding: 10px 18px; cursor: pointer; }
    </style>
</head>
<body>
    <h1>Enter Your User Details</h1>

    @using (Html.BeginForm("Create", "Emp", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="form-group">
            @Html.LabelFor(m => m.Name)
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.Email)
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.Bio)
            @Html.TextAreaFor(m => m.Bio, new { @class = "form-control", rows = 4 })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.SelectedCountry)
            @Html.DropDownListFor(m => m.SelectedCountry, Model.Countries, "Select a Country", new { @class = "form-control" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.IsSubscribed)
            @Html.CheckBoxFor(m => m.IsSubscribed)
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.Password)
            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.IsAdmin)
            <div>
                @Html.RadioButtonFor(m => m.IsAdmin, true) <span>Admin</span>
                @Html.RadioButtonFor(m => m.IsAdmin, false) <span>User</span>
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.SelectedHobbies)
            @Html.ListBoxFor(m => m.SelectedHobbies, new List<SelectListItem>
            {
                new SelectListItem { Text = "Reading", Value = "Reading" },
                new SelectListItem { Text = "Traveling", Value = "Traveling" },
                new SelectListItem { Text = "Coding", Value = "Coding" }
            }, new { @class = "form-control", multiple = "multiple" })
        </div>
        @Html.Hidden("FormSource", "Practical 8")
        <button type="submit">Submit</button>
        <p>
            @Html.ActionLink("Back To List", "Index", "Emp") |
            @Html.RouteLink("HomePage", "Default", new { controller = "Emp", action = "Create" }) |
            @Html.ActionLink("Go To Success", "Success", "Emp", new { id = 123 }, null)
        </p>
    }
</body>
</html>
