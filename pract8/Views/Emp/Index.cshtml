@model IEnumerable<pract8.Models.EmployeeModel>
@{
    ViewBag.Title = "Employee List";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
</head>
<body>
    <h1>Employee List</h1>
    <p>@Html.ActionLink("Create Employee", "Create", "Emp")</p>
    <table border="1" cellpadding="8">
        <thead>
            <tr><th>Name</th><th>Email</th><th>Country</th><th>Subscribed</th><th>Role</th></tr>
        </thead>
        <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Name</td>
                <td>@employee.Email</td>
                <td>@employee.SelectedCountry</td>
                <td>@employee.IsSubscribed</td>
                <td>@(employee.IsAdmin ? "Admin" : "User")</td>
            </tr>
        }
        </tbody>
    </table>
</body>
</html>
